{
  "name": "dsh-doc-focus",
  "version": "0.1.1",
  "description": "在 DSH 原生右侧栏全屏查看文档或浏览器，同时在底部保留主会话输入框与回复区。",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "deepseek",
    "sidebar",
    "fullscreen",
    "focus-mode",
    "codex"
  ],
  "author": "Altha-dt",
  "license": "MIT",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "src",
    "cordis.patch.yml",
    "icon.svg",
    "locale",
    "README.md",
    "LICENSE"
  ],
  "icon": "./icon.svg",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Altha-dt/dsh-doc-focus.git"
  },
  "homepage": "https://github.com/Altha-dt/dsh-doc-focus#readme",
  "bugs": {
    "url": "https://github.com/Altha-dt/dsh-doc-focus/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=20",
    "dsh": ">=0.2.1-rc.1"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.5",
    "@deepseek-ai/dsh-client-ui-conversation": "^0.2.1-rc.1",
    "@deepseek-ai/dsh-client-ui-sidebar-right": "^0.2.1-rc.1"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh-client-ui-conversation": {
      "optional": true
    },
    "@deepseek-ai/dsh-client-ui-sidebar-right": {
      "optional": true
    }
  },
  "dsh": {
    "manifestVersion": 1,
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-sidebar-right",
        "@deepseek-ai/dsh-client-ui-conversation"
      ]
    },
    "compatibility": {
      "dshReleases": {
        "0.2.1-rc.1": "compatible",
        "0.2.1-rc.5": "compatible"
      }
    }
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "test": "node --test tests/*.test.mjs",
    "check": "node --check src/client.js && node --check src/index.js"
  },
  "devDependencies": {
    "playwright-core": "^1.56.0"
  }
}
